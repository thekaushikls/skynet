#!/bin/bash
# Personal toolchain (gitignored). Uncomment/edit what you want, run manually:
#   docker exec skynet bash /scripts/toolchain.local.sh
#
# Installs into $HOME as `agent` (no root needed); persists via the
# toolchain-* volumes in docker-compose.override.yml. System packages (apt)
# go in the Dockerfile instead.

set -euo pipefail

# --- uv ---
# command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | sh
# uv python install 3.11 3.12 3.13
# uv tool install ruff

