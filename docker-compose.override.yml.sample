# Personal/local volume mounts.
#
# Copy this file to docker-compose.override.yml (gitignored) and adjust as
# needed. docker-compose.yml builds and runs fine without it, but you'll
# lose the .ssh mount and the toolchain-* volumes that persist manually
# installed tools across `down`/`up`.

services:
  develop:
    environment:
      - PATH=/usr/local/share/npm-global/bin:/home/agent/.local/bin:/home/agent/.cargo/bin:/home/agent/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      - NVM_DIR=/home/agent/.nvm
    volumes:
      - ./extensions/marketplace:/marketplace
      - ./extensions/.ssh:/home/agent/.ssh

      # Persist manually-installed toolchain across down/up
      - toolchain-local:/home/agent/.local
      - toolchain-cargo:/home/agent/.cargo
      - toolchain-rustup:/home/agent/.rustup
      - toolchain-bun:/home/agent/.bun
      - toolchain-nvm:/home/agent/.nvm

volumes:
  toolchain-local:
  toolchain-cargo:
  toolchain-rustup:
  toolchain-bun:
  toolchain-nvm:
